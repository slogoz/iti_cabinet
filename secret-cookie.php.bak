<?php

function set_custom_auth_cookie($user_id, $remember)
{
    // Установите свою "секретную" куку, например, с токеном
    $token = hash('sha256', uniqid(mt_rand(), true));
    setcookie('my_secret_token', $token, time() + (86400 * 30), '/'); // 30 дней

    // Сохраните токен в базе данных или метаданных пользователя
    update_user_meta($user_id, '_secret_token', $token);

    // Устанавливаем стандартные куки WordPress
    wp_set_current_user($user_id);
    wp_set_auth_cookie($user_id, $remember);
}

function check_custom_auth_cookie()
{
    // Проверяем, есть ли у пользователя "секретная" кука
    if (isset($_COOKIE['my_secret_token'])) {

        $token = $_COOKIE['my_secret_token'];

        // Найти пользователя по токену
        $user_query = new WP_User_Query([
            'meta_key' => '_secret_token',
            'meta_value' => $token,
            'number' => 1,
        ]);

        if (!empty($user_query->get_results())) {
            // Получаем ID пользователя
            $user = $user_query->get_results()[0];

            // Выполняем авторизацию
            wp_set_current_user($user->ID);
            wp_set_auth_cookie($user->ID);

            setcookie('my_secret_token', '', time() - 3600, '/'); // Удаляем куку

            // Выходим из функции
//            header("Location: " . $_SERVER['REQUEST_URI']);
//            exit;
            return;
        }
    }
}

add_action('plugins_loaded', 'check_custom_auth_cookie');

function delete_custom_auth_cookie()
{
    setcookie('my_secret_token', '', time() - 3600, '/'); // Удаляем куку
}

add_action('wp_logout', 'delete_custom_auth_cookie');
